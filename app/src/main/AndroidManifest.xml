<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền truy cập mạng Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CarePlusClinic">

        <!-- Màn hình Đăng nhập (Khởi động đầu tiên) -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình Chính -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Màn hình Đặt lịch khám -->
        <activity
            android:name=".ui.BookAppointmentActivity"
            android:exported="false" />

        <!-- Phân hệ Lễ tân: Tiếp nhận vãng lai & Cấp số thứ tự -->
        <activity
            android:name=".ui.WalkInReceptionActivity"
            android:exported="false" />

        <!-- Phân hệ Lễ tân: Tra cứu & Đăng ký hồ sơ bệnh nhân -->
        <activity
            android:name=".ui.PatientLookupActivity"
            android:exported="false" />

        <!-- Phân hệ Điều dưỡng: Ghi nhận chỉ số sinh hiệu -->
        <activity
            android:name=".ui.RecordVitalSignsActivity"
            android:exported="false" />

        <!-- Phân hệ Kỹ thuật viên: Cận lâm sàng & Xét nghiệm -->
        <activity
            android:name=".ui.TechnicianStationActivity"
            android:exported="false" />

        <!-- Phân hệ Dược sĩ: Trạm cấp phát thuốc & Kho dược -->
        <activity
            android:name=".ui.PharmacyStationActivity"
            android:exported="false" />

        <!-- Phân hệ Thu ngân: Quầy thu ngân & viện phí -->
        <activity
            android:name=".ui.CashierStationActivity"
            android:exported="false" />

        <!-- Phân hệ Bác sĩ: Khám bệnh, chẩn đoán, chỉ định cận lâm sàng -->
        <activity
            android:name=".ui.DoctorStationActivity"
            android:exported="false" />

        <!-- Phân hệ Nhân sự: Lịch trực ca & Chấm công -->
        <activity
            android:name=".ui.StaffSchedulingActivity"
            android:exported="false" />

    </application>

</manifest>