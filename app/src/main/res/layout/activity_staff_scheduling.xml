<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarStaff"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="Lịch Trực Ca &amp; Chấm Công"
        app:titleTextColor="@color/white" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshStaff"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Thẻ điểm danh / chấm công ca trực hiện tại -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ĐIỂM DANH CA TRỰC HÔM NAY"
                            android:textColor="@color/primary_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAttendanceStatusInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Bấm 'Vào ca trực' để bắt đầu điểm danh ca làm việc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnStaffCheckIn"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/accent_green"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Vào ca trực"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:cornerRadius="8dp" />

                            <Button
                                android:id="@+id/btnStaffCheckOut"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Kết thúc ca"
                                android:textColor="@color/accent_coral"
                                android:textSize="12sp"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Search Input -->
                <EditText
                    android:id="@+id/etSearchStaff"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Tìm theo tên nhân sự, chuyên khoa, ca trực..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <!-- Filter Tabs: Horizontal Scroll -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnTabSchedules"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="@color/primary"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="14dp"
                            android:text="Lịch trực ca"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:cornerRadius="18dp" />

                        <Button
                            android:id="@+id/btnTabStaffList"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="@color/bg_light"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="14dp"
                            android:text="Đội ngũ nhân sự"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            app:cornerRadius="18dp" />

                        <Button
                            android:id="@+id/btnTabMyAttendance"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="@color/bg_light"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="14dp"
                            android:text="Lịch sử chấm công"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            app:cornerRadius="18dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Tiêu đề danh sách -->
                <TextView
                    android:id="@+id/tvStaffSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="LỊCH TRỰC PHÒNG KHÁM"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- RecyclerView Lịch trực ca -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStaffSchedules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- RecyclerView Danh sách nhân viên -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStaffMembers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

                <!-- RecyclerView Lịch sử chấm công -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMyAttendance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
