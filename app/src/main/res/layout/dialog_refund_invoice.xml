<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvRefundDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hoàn Tiền / Hủy Hóa Đơn"
        android:textColor="@color/accent_coral"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRefundDialogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Hóa đơn: HD-2026-0001 | Bệnh nhân: Nguyễn Văn A"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/divider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lý do hoàn tiền / hủy giao dịch (bắt buộc):"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etRefundReason"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:gravity="top|start"
        android:hint="Ví dụ: Bệnh nhân đổi ý không làm xét nghiệm, thu nhầm dịch vụ..."
        android:inputType="textMultiLine"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Cảnh báo: Hành động này sẽ chuyển trạng thái hóa đơn sang ĐÃ HOÀN TIỀN (REFUNDED) và được ghi nhận đầy đủ vào nhật ký kiểm toán."
        android:textColor="@color/accent_coral"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelRefund"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="Đóng"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnConfirmRefund"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/accent_coral"
            android:text="Xác nhận hoàn tiền"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
